{
  "name": "gitview",
  "displayName": "GitView",
  "description": "See Git clearly. 3-way merge, history, branches, changes and diffs for VS Code.",
  "version": "0.1.0",
  "publisher": "gitview",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/outof0/gitview.git"
  },
  "bugs": {
    "url": "https://github.com/outof0/gitview/issues"
  },
  "homepage": "https://gitview.dev",
  "packageManager": "pnpm@9.12.0",
  "main": "./out/extension.js",
  "types": "./out/extension.d.ts",
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "node": ">=18",
    "vscode": "^1.85.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitView runs Git against your repository and requires a trusted workspace."
    }
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "git",
    "merge",
    "conflict",
    "3-way",
    "diff",
    "blame",
    "history",
    "scm",
    "monaco"
  ],
  "qna": "marketplace",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitView",
          "title": "GitView",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gitView": [
        {
          "type": "webview",
          "id": "gitView.workspace",
          "name": "Git Workspace"
        }
      ]
    },
    "submenus": [
      {
        "id": "gitView.git",
        "label": "Git"
      }
    ],
    "commands": [
      {
        "command": "gitView.openGit",
        "title": "GitView: Open Git workspace",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitView.open",
        "title": "Resolve conflict",
        "category": "Git",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitView.refresh",
        "title": "GitView: Refresh conflicts"
      },
      {
        "command": "gitView.refreshGitStatus",
        "title": "Refresh Git Status",
        "category": "GitView"
      },
      {
        "command": "gitView.resolveCurrentFile",
        "title": "Resolve conflict",
        "category": "Git"
      },
      {
        "command": "gitView.setGithubReviewToken",
        "title": "Set GitHub Review Token…",
        "category": "GitView"
      },
      {
        "command": "gitView.setGitlabReviewToken",
        "title": "Set GitLab Review Token…",
        "category": "GitView"
      },
      {
        "command": "gitView.clearGithubReviewToken",
        "title": "Clear GitHub Review Token",
        "category": "GitView"
      },
      {
        "command": "gitView.clearGitlabReviewToken",
        "title": "Clear GitLab Review Token",
        "category": "GitView"
      },
      {
        "command": "gitView.showGitHistory",
        "title": "Show History",
        "icon": "$(history)"
      },
      {
        "command": "gitView.gitCompareWithRevision",
        "title": "Compare with Revision…"
      },
      {
        "command": "gitView.gitCompareWithBranch",
        "title": "Compare with Branch…"
      },
      {
        "command": "gitView.gitShowDiff",
        "title": "Show Diff"
      },
      {
        "command": "gitView.gitAnnotateBlame",
        "title": "Annotate with Git Blame"
      },
      {
        "command": "gitView.gitRollback",
        "title": "Rollback",
        "icon": "$(discard)"
      },
      {
        "command": "gitView.gitAdd",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "gitView.gitUnstage",
        "title": "Unstage"
      },
      {
        "command": "gitView.gitCommit",
        "title": "Commit…",
        "icon": "$(git-commit)",
        "enablement": "gitView.git.canCommit"
      },
      {
        "command": "gitView.gitCommitAndPush",
        "title": "Commit and Push…",
        "icon": "$(git-commit)",
        "enablement": "gitView.git.canCommit"
      },
      {
        "command": "gitView.gitFetch",
        "title": "Fetch",
        "icon": "$(git-fetch)",
        "enablement": "gitView.git.canFetch"
      },
      {
        "command": "gitView.gitPull",
        "title": "Pull…",
        "icon": "$(repo-pull)",
        "enablement": "gitView.git.canPull"
      },
      {
        "command": "gitView.gitPush",
        "title": "Push…",
        "icon": "$(repo-push)",
        "enablement": "gitView.git.canPush"
      },
      {
        "command": "gitView.gitSync",
        "title": "Sync",
        "icon": "$(sync)",
        "enablement": "gitView.git.canSync"
      },
      {
        "command": "gitView.gitCheckoutBranch",
        "title": "Branches…",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitView.gitCreateBranch",
        "title": "New Branch…",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitView.gitStash",
        "title": "Stash Changes…",
        "enablement": "gitView.git.canStash"
      },
      {
        "command": "gitView.gitUnstash",
        "title": "Unstash Changes…",
        "enablement": "gitView.git.canUnstash"
      },
      {
        "command": "gitView.gitShelve",
        "title": "Shelve Changes…",
        "enablement": "gitView.git.canShelve"
      },
      {
        "command": "gitView.gitUnshelve",
        "title": "Unshelve Changes…",
        "enablement": "gitView.git.canUnshelve"
      },
      {
        "command": "gitView.gitMerge",
        "title": "Merge…",
        "enablement": "gitView.git.canIntegrate"
      },
      {
        "command": "gitView.gitRebase",
        "title": "Rebase…",
        "enablement": "gitView.git.canIntegrate"
      }
    ],
    "keybindings": [
      {
        "command": "gitView.open",
        "key": "alt+shift+m",
        "mac": "cmd+alt+shift+m",
        "when": "git.mergeChangesCount != 0 && editorTextFocus && resourceScheme == file && git.activeResourceHasMergeConflicts"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "gitView.git",
          "group": "z_git@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "submenu": "gitView.git",
          "group": "z_git@1",
          "when": "resourceScheme == file"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "gitView.git",
          "group": "z_git@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitView.open",
          "group": "navigation@0",
          "when": "resource in git.mergeChanges && !isInDiffEditor && !isMergeEditor && resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "gitView.openGit",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitView.open",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitView.refresh",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitView.resolveCurrentFile",
          "when": "workspaceFolderCount > 0 && editorTextFocus"
        },
        {
          "command": "gitView.showGitHistory",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "gitView.gitCompareWithRevision",
          "when": "false"
        },
        {
          "command": "gitView.gitCompareWithBranch",
          "when": "false"
        },
        {
          "command": "gitView.gitShowDiff",
          "when": "false"
        },
        {
          "command": "gitView.gitAnnotateBlame",
          "when": "false"
        },
        {
          "command": "gitView.gitRollback",
          "when": "false"
        },
        {
          "command": "gitView.gitAdd",
          "when": "false"
        },
        {
          "command": "gitView.gitUnstage",
          "when": "false"
        },
        {
          "command": "gitView.gitCommit",
          "when": "false"
        },
        {
          "command": "gitView.gitCommitAndPush",
          "when": "false"
        },
        {
          "command": "gitView.gitFetch",
          "when": "false"
        },
        {
          "command": "gitView.gitPull",
          "when": "false"
        },
        {
          "command": "gitView.gitPush",
          "when": "false"
        },
        {
          "command": "gitView.gitSync",
          "when": "false"
        },
        {
          "command": "gitView.gitCheckoutBranch",
          "when": "false"
        },
        {
          "command": "gitView.gitCreateBranch",
          "when": "false"
        },
        {
          "command": "gitView.gitStash",
          "when": "false"
        },
        {
          "command": "gitView.gitUnstash",
          "when": "false"
        },
        {
          "command": "gitView.gitShelve",
          "when": "false"
        },
        {
          "command": "gitView.gitUnshelve",
          "when": "false"
        },
        {
          "command": "gitView.gitMerge",
          "when": "false"
        },
        {
          "command": "gitView.gitRebase",
          "when": "false"
        }
      ],
      "gitView.git": [
        {
          "command": "gitView.open",
          "group": "0_merge@1",
          "when": "git.mergeChangesCount != 0"
        },
        {
          "command": "gitView.showGitHistory",
          "group": "1_history@1"
        },
        {
          "command": "gitView.gitCompareWithRevision",
          "group": "1_history@2",
          "when": "resourceScheme == file && !(explorerViewletVisible && explorerResourceIsFolder)"
        },
        {
          "command": "gitView.gitCompareWithBranch",
          "group": "1_history@3",
          "when": "resourceScheme == file && !(explorerViewletVisible && explorerResourceIsFolder)"
        },
        {
          "command": "gitView.gitShowDiff",
          "group": "1_history@4",
          "when": "resourceScheme == file && !(explorerViewletVisible && explorerResourceIsFolder)"
        },
        {
          "command": "gitView.gitAnnotateBlame",
          "group": "2_local@1",
          "when": "resourceScheme == file && !(explorerViewletVisible && explorerResourceIsFolder)"
        },
        {
          "command": "gitView.gitRollback",
          "group": "2_local@2",
          "when": "resourceScheme == file && !(explorerViewletVisible && explorerResourceIsFolder)"
        },
        {
          "command": "gitView.gitAdd",
          "group": "2_local@3"
        },
        {
          "command": "gitView.gitUnstage",
          "group": "2_local@4"
        },
        {
          "command": "gitView.gitCommit",
          "group": "3_commit@1"
        },
        {
          "command": "gitView.gitCommitAndPush",
          "group": "3_commit@2"
        },
        {
          "command": "gitView.gitFetch",
          "group": "4_remote@1"
        },
        {
          "command": "gitView.gitPull",
          "group": "4_remote@2"
        },
        {
          "command": "gitView.gitPush",
          "group": "4_remote@3"
        },
        {
          "command": "gitView.gitSync",
          "group": "4_remote@4"
        },
        {
          "command": "gitView.gitCheckoutBranch",
          "group": "5_vcs@1"
        },
        {
          "command": "gitView.gitCreateBranch",
          "group": "5_vcs@2"
        },
        {
          "command": "gitView.gitStash",
          "group": "5_vcs@3"
        },
        {
          "command": "gitView.gitUnstash",
          "group": "5_vcs@4"
        },
        {
          "command": "gitView.gitShelve",
          "group": "5_vcs@5"
        },
        {
          "command": "gitView.gitUnshelve",
          "group": "5_vcs@6"
        },
        {
          "command": "gitView.gitMerge",
          "group": "6_integrate@1"
        },
        {
          "command": "gitView.gitRebase",
          "group": "6_integrate@2"
        }
      ]
    },
    "configuration": {
      "title": "GitView",
      "properties": {
        "gitView.mergeEngine": {
          "type": "string",
          "enum": [
            "threeWay",
            "markers"
          ],
          "default": "threeWay",
          "description": "Merge model. 'threeWay' builds a real 3-way diff from Git stages. 'markers' only parses conflict markers."
        },
        "gitView.conflictPlaceholder": {
          "type": "string",
          "enum": [
            "base"
          ],
          "default": "base",
          "description": "Initial content of an unresolved conflict block in the result pane. Default starts from the base revision."
        },
        "gitView.acceptBothOrder": {
          "type": "string",
          "enum": [
            "oursFirst",
            "theirsFirst"
          ],
          "default": "oursFirst",
          "description": "Controls the order when accepting both sides of a conflict."
        },
        "gitView.autoStageOnResolved": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run git add after marking a file as resolved."
        },
        "gitView.showBasePanel": {
          "type": "boolean",
          "default": false,
          "description": "Show the base version as an optional fourth panel."
        },
        "gitView.confirmBeforeMarkResolved": {
          "type": "boolean",
          "default": false,
          "description": "Optional extra confirmation before Apply writes the result. Off by default so resolved conflicts apply without a second prompt."
        },
        "gitView.enableScrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Synchronize scrolling between merge panes."
        },
        "gitView.showWordLevelDiff": {
          "type": "boolean",
          "default": true,
          "description": "Highlight word/character-level differences within conflict blocks."
        },
        "gitView.autoResolveBothSame": {
          "type": "boolean",
          "default": true,
          "description": "Automatically resolve blocks where ours and theirs are identical."
        },
        "gitView.whitespacePolicy": {
          "type": "string",
          "enum": [
            "doNotIgnore",
            "ignoreWhitespaces",
            "trimWhitespaces"
          ],
          "default": "doNotIgnore",
          "description": "How whitespace differences are treated when diffing."
        },
        "gitView.highlightingMode": {
          "type": "string",
          "enum": [
            "words",
            "lines",
            "none"
          ],
          "default": "lines",
          "description": "Granularity of diff highlighting."
        },
        "gitView.warnOnCrlf": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning banner when LF and CRLF line separators are mixed."
        },
        "gitView.goToNextFileAfterLastChange": {
          "type": "boolean",
          "default": true,
          "description": "When F7 or Shift+F7 reaches the last/first difference in a file, open the next/previous conflict file."
        },
        "gitView.foldUnchangedRegions": {
          "type": "boolean",
          "default": false,
          "description": "Collapse long unchanged runs in the merge resolver."
        },
        "gitView.foldThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Minimum unchanged line count before a region can collapse."
        },
        "gitView.gitExecutablePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the Git executable. When null, GitView uses git from PATH."
        },
        "gitView.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Minimum severity written to the GitView output channel. 'debug' includes per-refresh timing records."
        },
        "gitView.crlfWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings when a file's line endings do not match Git attributes (.gitattributes)."
        },
        "gitView.protectedBranchPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "release/*",
            "hotfix/*",
            "production"
          ],
          "description": "Branch name patterns that block destructive history and force-push actions."
        },
        "gitView.mode": {
          "type": "string",
          "enum": [
            "staging",
            "changelist"
          ],
          "default": "staging",
          "description": "Default local changes grouping mode."
        },
        "gitView.confirmDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before destructive Git actions."
        },
        "gitView.gpgSigningDefault": {
          "type": "boolean",
          "default": false,
          "description": "Sign commits with GPG by default."
        },
        "gitView.updateStrategy": {
          "type": "string",
          "enum": [
            "merge",
            "rebase",
            "ff_only"
          ],
          "default": "merge",
          "description": "Default pull/update strategy for the Git widget."
        },
        "gitView.synchronousBranchControl": {
          "type": "boolean",
          "default": true,
          "description": "When enabled in multi-root workspaces, branch checkout applies to matching repositories after confirmation."
        },
        "gitView.gitDiffViewMode": {
          "type": "string",
          "enum": [
            "side_by_side",
            "unified"
          ],
          "default": "side_by_side",
          "description": "Default layout for Git working-tree diffs."
        },
        "gitView.graphSort": {
          "type": "string",
          "enum": [
            "date",
            "topological"
          ],
          "default": "date",
          "description": "Default ordering for the commit graph."
        },
        "gitView.highlightCurrentBranch": {
          "type": "boolean",
          "default": true,
          "description": "Highlight commits that belong to the current branch in the commit graph."
        },
        "gitView.compactLogRows": {
          "type": "boolean",
          "default": false,
          "description": "Use compact rows in the commit log."
        },
        "gitView.issueTrackerBaseUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional issue tracker URL used to link issue references in commit messages."
        },
        "gitView.githubReviewToken": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Deprecated fallback for GitHub review auth. Prefer **GitView: Set GitHub Review Token…** (Secret Storage). When both are set, Secret Storage wins; a settings value is moved into Secret Storage and removed from settings on first use."
        },
        "gitView.githubApiBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "https://api.github.com",
          "description": "GitHub REST API base URL. Must use HTTPS and match the Git remote host; use https://github.example.com/api/v3 for GitHub Enterprise."
        },
        "gitView.gitlabReviewToken": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Deprecated fallback for GitLab review auth. Prefer **GitView: Set GitLab Review Token…** (Secret Storage). When both are set, Secret Storage wins; a settings value is moved into Secret Storage and removed from settings on first use."
        },
        "gitView.gitlabApiBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "https://gitlab.com/api/v4",
          "description": "GitLab REST API base URL. Must use HTTPS and match the Git remote host; use https://gitlab.example.com/api/v4 for self-hosted GitLab."
        },
        "gitView.commitCheckTodo": {
          "type": "boolean",
          "default": false,
          "description": "Warn when committing files that contain TODO/FIXME markers."
        },
        "gitView.commitCheckAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Block commit when changed files have error-level diagnostics."
        },
        "gitView.commitCheckReformat": {
          "type": "boolean",
          "default": false,
          "description": "Reformat changed files before commit."
        },
        "gitView.commitCheckOptimizeImports": {
          "type": "boolean",
          "default": false,
          "description": "Optimize imports in changed files before commit."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run build:webview && pnpm run build:ext",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:deadcode": "knip --no-progress --include files",
    "check:package": "vsce ls --no-dependencies | node scripts/check-package-contents.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "build:ext": "rimraf out && tsc -p ./tsconfig.json && pnpm run bundle:ext",
    "bundle:ext": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=./out/extension.js --log-level=warning",
    "build:webview": "pnpm --filter gitview-webview run build",
    "watch": "pnpm run -r --parallel watch",
    "watch:ext": "tsc -watch -p ./tsconfig.json",
    "watch:webview": "pnpm --filter gitview-webview run watch",
    "dev:playground": "pnpm --filter gitview-webview run dev:playground",
    "typecheck": "tsc --noEmit -p ./tsconfig.json && pnpm --filter gitview-webview run typecheck",
    "lint": "oxlint src webview/src e2e scripts",
    "format": "prettier --write .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "pnpm run bench:lcs",
    "bench:lcs": "vitest bench src/core/__benchmarks__/lcs.quick.bench.ts --run",
    "bench:lcs:stress": "vitest bench src/core/__benchmarks__/lcs.stress.bench.ts --run",
    "test:setup": "bash scripts/setup-test-repo.sh",
    "test:setup:clean": "bash scripts/setup-test-clean-repo.sh",
    "test:int": "pnpm run build && pnpm run test:setup && node ./out/test/runIntegration.js",
    "test:e2e": "pnpm run build && pnpm run test:setup && pnpm exec playwright test",
    "test:e2e:smoke": "pnpm run build && pnpm run test:setup && pnpm exec playwright test e2e/native-webview-git-submenu.spec.ts && pnpm exec playwright test e2e/native-merge-resolver.spec.ts",
    "test:e2e:mock": "pnpm run build && pnpm run test:setup && E2E_MOCK=1 pnpm exec playwright test",
    "test:e2e:screens": "pnpm run build && pnpm run test:setup && pnpm exec playwright test e2e/native-git-blame-screen.spec.ts e2e/native-git-diff-screen.spec.ts e2e/native-git-history-screen.spec.ts e2e/native-explorer-git-audit.spec.ts e2e/native-webview-git-submenu.spec.ts",
    "test:e2e:headed": "pnpm run build && pnpm run test:setup && HEADED=1 pnpm exec playwright test --headed",
    "test:e2e:ui": "pnpm run build && pnpm run test:setup && pnpm exec playwright test --ui",
    "test:e2e:visual": "pnpm run build && E2E_MOCK=1 pnpm exec playwright test e2e/visual-*.spec.ts",
    "test:e2e:visual:update": "pnpm run build && E2E_MOCK=1 pnpm exec playwright test e2e/visual-*.spec.ts --update-snapshots",
    "security:audit": "pnpm audit --audit-level=low",
    "quality": "pnpm run check:architecture && pnpm run check:docs && pnpm run check:deadcode && pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build && pnpm run check:bundle && pnpm run check:package",
    "quality:release": "pnpm run quality && pnpm run security:audit && pnpm run test:int && pnpm run test:e2e && pnpm exec vsce package --no-dependencies",
    "package": "pnpm run build && pnpm run check:bundle && pnpm run check:package && vsce package --no-dependencies",
    "publish:marketplace": "pnpm run package && vsce publish",
    "publish:ovsx": "pnpm run package && ovsx publish gitview-$(node -p \"require('./package.json').version\").vsix",
    "changelog": "changelogen --output CHANGELOG.md",
    "changelog:preview": "changelogen",
    "release": "bumpp --execute \"pnpm run changelog\" --commit \"chore(release): v%s\" --tag \"v%s\" --push",
    "clean": "rimraf dist out webview/dist"
  },
  "pnpm": {
