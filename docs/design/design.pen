                          "name": "Code 2",
                          "fill": "#9E9E9E",
                          "content": "  const ours = parseOurs(model.local);",
                          "fontFamily": "$nx-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "m8lSE",
