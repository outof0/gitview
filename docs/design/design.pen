                          "fontFamily": "$nx-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "XLMcZ",
                          "name": "Code 6",
                          "fill": "#9E9E9E",
                          "content": "  return { result: threeWay(base, ours, theirs) };",
                          "fontFamily": "$nx-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
