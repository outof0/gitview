                          "fill": "#9E9E9E",
                          "content": "  const theirs = parseTheirs(model.incoming);",
                          "fontFamily": "$nx-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "qql5l",
                          "name": "Code 4",
                          "fill": "#9E9E9E",
                          "content": "  const base = parseBase(model.common);",
                          "fontFamily": "$nx-mono",
                          "fontSize": 11.5,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "ZZ9we",
